# ConnectWise Manage (PSA) API credentials
# See README.md for how these map to values in ConnectWise Manage.

# Your CW Manage site, versioned API base URL, e.g.:
#   Cloud:   https://api-na.myconnectwise.net/v2025_1/apis/3.0
#   On-prem: https://yourcompany.com/v4_6_release/apis/3.0
CW_BASE_URL=

CW_COMPANY_ID=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
CW_CLIENT_ID=

# Blackpoint CompassOne API
# Create under: CompassOne portal (compassone.blackpointcyber.com) > Administration > API Keys
BLACKPOINT_API_KEY=
BLACKPOINT_BASE_URL=https://api.blackpointcyber.com

# NinjaRMM / NinjaOne API
# Create under: NinjaOne portal > Administration > Apps > API > Client App IDs
# NINJA_BASE_URL must match your instance's region (e.g. https://us2.ninjarmm.com)
NINJA_BASE_URL=https://us2.ninjarmm.com
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
# Onboarding (creating an organization) needs the Client App to allow the "management" scope.
# Optional: id of an existing organization to copy settings and policies from.
# NINJA_TEMPLATE_ORGANIZATION_ID=
# AUTOMATIC, MANUAL or REJECT: how devices registering under a new organization are approved.
NINJA_NODE_APPROVAL_MODE=MANUAL

# CloudRadial API (HTTP Basic auth: public key as username, private key as password)
CLOUDRADIAL_BASE_URL=https://api.us.cloudradial.com
CLOUDRADIAL_PUBLIC_KEY=
CLOUDRADIAL_PRIVATE_KEY=

# Sophos Central API (partner/MSP account, OAuth2 client-credentials)
# Create under: Sophos Central partner console > Settings > API Credentials Management
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=

# ConnectSecure API (base URL must match your pod, e.g. https://pod102.myconnectsecure.com)
# Create under: ConnectSecure admin console > Integrations/API > API Clients
CONNECTSECURE_BASE_URL=https://pod102.myconnectsecure.com
CONNECTSECURE_TENANT=
CONNECTSECURE_CLIENT_ID=
CONNECTSECURE_CLIENT_SECRET=

# Evo Security Partner API (Bearer API key)
EVO_BASE_URL=https://partner-api.evosecurity.com
EVO_API_KEY=

# Dropsuite (DropMyEmail) Subreseller API
# DROPSUITE_BASE_URL is region-specific (e.g. your portal's own subdomain) - check
# the API Settings page for your reseller token, and your admin Organization's
# Login Accounts tab for the access token.
DROPSUITE_BASE_URL=
DROPSUITE_RESELLER_TOKEN=
DROPSUITE_ACCESS_TOKEN=

# Optional: comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173
