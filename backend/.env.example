# ConnectWise Manage (PSA) API credentials
# See README.md for how these map to values in ConnectWise Manage.

# Your CW Manage site, versioned API base URL, e.g.:
#   Cloud:   https://api-na.myconnectwise.net/v2025_1/apis/3.0
#   On-prem: https://yourcompany.com/v4_6_release/apis/3.0
CW_BASE_URL=

CW_COMPANY_ID=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
CW_CLIENT_ID=

# Blackpoint CompassOne API
# Create under: CompassOne portal (compassone.blackpointcyber.com) > Administration > API Keys
BLACKPOINT_API_KEY=
BLACKPOINT_BASE_URL=https://api.blackpointcyber.com

# NinjaRMM / NinjaOne API
# Create under: NinjaOne portal > Administration > Apps > API > Client App IDs
# NINJA_BASE_URL must match your instance's region (e.g. https://us2.ninjarmm.com)
NINJA_BASE_URL=https://us2.ninjarmm.com
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# CloudRadial API (HTTP Basic auth: public key as username, private key as password)
CLOUDRADIAL_BASE_URL=https://api.us.cloudradial.com
CLOUDRADIAL_PUBLIC_KEY=
CLOUDRADIAL_PRIVATE_KEY=

# Optional: comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173
